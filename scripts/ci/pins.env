# Toolchain pins for the self-hosted CI runners. Read by
# provision-windows.ps1 and linux-runner/install-tools.sh; bump a version and
# its sha256 together, then re-provision the runners (docs/agents/ci.md).
# scripts/engine_bundle.py reads the PBS_ pins; they need no re-provisioning.
# Plain KEY=VALUE lines only (PowerShell parses this with ConvertFrom-StringData).
#
# RUNNER_VERSION is only where a runner starts: it updates itself, but a
# rebuilt Linux image or a re-registered Windows runner starts from the pin,
# and GitHub refuses runners that are too old. Bump it with any other pin.

RUNNER_VERSION=2.337.0
RUNNER_SHA256_WINDOWS=1150692afa94e71f872017e254ea55b6eece1eece3fe7e3a6d4c93d0a1b85cfc
RUNNER_SHA256_LINUX=70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613

RUST_VERSION=1.98.1
RUSTUP_VERSION=1.29.1
RUSTUP_SHA256_WINDOWS=6f4bef66261261fcb43131be8720bab817d403a09edec7455c371974b90bdb7e
RUSTUP_SHA256_LINUX=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71

CMAKE_VERSION=4.4.3
CMAKE_SHA256_WINDOWS=4d52ebab7193a698651639ed80d8d04fd903358843572cf44c7fd234cb7c26ab
CMAKE_SHA256_LINUX=d6c83076c575bc00b823522ac974bda66d0af05d6ddc30e739c12385cf32c6cc

NINJA_VERSION=1.13.2
NINJA_SHA256_WINDOWS=07fc8261b42b20e71d1720b39068c2e14ffcee6396b76fb7a795fb460b78dc65
NINJA_SHA256_LINUX=5749cbc4e668273514150a80e387a957f933c6ed3f5f11e03fb30955e2bbead6

NODE_VERSION=24.21.0
NODE_SHA256_WINDOWS=158f7685b44de51f6c0df1d153526cbcd3e1bc739a8dfc607721cef75de9e541
NODE_SHA256_LINUX=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6

UV_VERSION=0.12.19
UV_SHA256_WINDOWS=6dbb02d79e419522f1c500f0adb1cddcff0cda7d59b0d66ea7f5e3b4a1b2f5f0
UV_SHA256_LINUX=23bf5552d220e0842b65c862097b2ebaeba0064b74eda5e565e77fd25969d8c8

# Installed by uv; the engine bundle ships python-build-standalone 3.12 too.
PYTHON_VERSION=3.12

# The engine bundles' interpreter: python-build-standalone's install_only_stripped
# build of PBS_PYTHON from release PBS_RELEASE, one sha256 per target triple
# (from the release's SHA256SUMS).
PBS_RELEASE=20260929
PBS_PYTHON=3.12.14
PBS_SHA256_AARCH64_APPLE_DARWIN=1bb3e53d231ee2c8881e8daf6426f4dd95bff0dda496af0f3af300357aa998d0
PBS_SHA256_X86_64_APPLE_DARWIN=62891cf4a32ed18b6b4174def999184b5186371422c52dd92d941401db0f0e41
PBS_SHA256_X86_64_PC_WINDOWS_MSVC=f38e68f4d612ade6dd50c894fc80b14c0be0c3b5201145d6fff5f20b9323204d
PBS_SHA256_X86_64_UNKNOWN_LINUX_GNU=ef605200f8174e87ecfc308e52a88127543f85dd5c940dc5e92cab244b98a003

# The nauty source the topology lists are generated from (scripts/topology_lists.py, run by hand;
# ADR-0017). No runner builds it: the lists are checked in, so these need no re-provisioning.
NAUTY_VERSION=2.9.3
NAUTY_SHA256=9fc4edae04f88a0f5883985be3b39cf7f898fd6cc96e96b9ee25452743cc1b5b

# Windows only: aws-lc-sys (via russh) assembles with NASM.
NASM_VERSION=3.02
NASM_SHA256_WINDOWS=161d0bfaff53c2f9e9f3e69fd0672323ebabafd1268976a5cec11be92a19aee7

# Windows only: PortableGit, so CI's git and bash don't follow the desktop's.
GIT_TAG=v2.55.0.windows.5
GIT_VERSION=2.55.0.5
GIT_SHA256_WINDOWS=5aa8a20f6e9abb2c755f0e73c91c687701a46b309ad84a0ca6509380fa4ae290
