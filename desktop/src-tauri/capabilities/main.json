{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: a trimmed core subset. The app's own commands are allowed in wire.json.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:menu:allow-new",
    "core:menu:allow-popup",
    "core:webview:default",
    "core:window:default"
  ]
}
